# NextHire Production & Development Environment Configuration
# Target Domain: https://www.nexthire.cloud

# -----------------------------------------------------------------------------
# 1. PUBLIC PLATFORM DOMAIN & BASE URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://www.nexthire.cloud
NEXT_PUBLIC_ENVIRONMENT=production # production | development

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Prisma ORM)
# -----------------------------------------------------------------------------
# Production PostgreSQL (Neon / Supabase / AWS RDS):
DATABASE_URL="postgresql://nexthire_user:secure_password@ep-production-db.neon.tech/nexthire_prod?sslmode=require"

# Development SQLite fallback:
# DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# 3. FIREBASE AUTHENTICATION & FIRESTORE (Production SDK)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA_Production_Firebase_Key_Here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nexthire-cloud.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nexthire-cloud
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nexthire-cloud.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=84920184920
NEXT_PUBLIC_FIREBASE_APP_ID=1:84920184920:web:a1b2c3d4e5f6

# -----------------------------------------------------------------------------
# 4. STRIPE SAAS BILLING ENGINE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51NexthireProductionStripeKeyHere
STRIPE_SECRET_KEY=sk_live_51NexthireSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_ProductionWebhookSecretHere

# -----------------------------------------------------------------------------
# 5. CLOUDINARY RESUME & LOGO STORAGE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=nexthire-cloud
CLOUDINARY_API_KEY=84920194819
CLOUDINARY_API_SECRET=ProductionCloudinarySecretHere

# -----------------------------------------------------------------------------
# 6. RESEND EMAIL TRANSACTIONAL NOTIFICATIONS
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_ProductionResendKeyHere
FROM_EMAIL=notifications@nexthire.cloud
