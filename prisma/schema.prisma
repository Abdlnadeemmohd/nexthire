datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  JOB_SEEKER
  RECRUITER
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
  HYBRID
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
  DRAFT
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  role          UserRole       @default(JOB_SEEKER)
  avatar        String?
  headline      String?
  bio           String?
  location      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])

  profile       Profile?
  jobs          Job[]          @relation("RecruiterJobs")
  applications  Application[]  @relation("SeekerApplications")
  savedJobs     SavedJob[]
  sentMessages     Message[]    @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")
  notifications Notification[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  industry    String
  location    String
  description String
  website     String?
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]
  jobs        Job[]
}

model Job {
  id               String         @id @default(uuid())
  title            String
  description      String
  responsibilities String
  requirements     String
  benefits         String
  location         String
  country          String
  salaryMin        Int
  salaryMax        Int
  employmentType   EmploymentType @default(FULL_TIME)
  experienceLevel  String
  category         String
  isRemote         Boolean        @default(false)
  skills           String         // Comma separated or JSON string
  status           JobStatus      @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  recruiterId      String
  recruiter        User           @relation("RecruiterJobs", fields: [recruiterId], references: [id])

  applications     Application[]
  savedBy          SavedJob[]
}

model Application {
  id           String            @id @default(uuid())
  status       ApplicationStatus @default(SUBMITTED)
  matchScore   Int               @default(85)
  resumeUrl    String?
  coverLetter  String?
  notes        String?
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  slaDeadline  DateTime?

  jobId        String
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    User              @relation("SeekerApplications", fields: [applicantId], references: [id], onDelete: Cascade)

  // Relations
  events       ApplicationEvent[]
  offer        Offer?
  rejection    Rejection?
  interviews   Interview[]
}

model SavedJob {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Interview {
  id            String          @id @default(uuid())
  round         Int
  scheduledAt   DateTime
  timezone      String
  type          String
  platform      String
  meetingLink   String?
  agenda        String?
  panelMembers  String[]
  documents     String[]
  notes         String?
  status        InterviewStatus @default(PENDING)
  createdAt     DateTime        @default(now())

  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(uuid())
  content     String
  attachment  String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id          String   @id @default(uuid())
  skills      String
  experience  String
  education   String
  portfolio   String
  resumeUrl   String?
  resumeScore Int      @default(92)
  updatedAt   DateTime @updatedAt

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Enums ----------
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  INTERVIEW_ROUND_1
  INTERVIEW_ROUND_2
  INTERVIEW_ROUND_3
  FINAL_DECISION
  OFFER_EXTENDED
  REJECTED
  APPLICATION_CLOSED
}

enum EventType {
  STATUS_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  OFFER_CREATED
  REJECTION_SUBMITTED
  NOTE_ADDED
  SLA_REMINDER_SENT
  AUTO_CLOSED
}

enum InterviewStatus {
  PENDING
  PASSED
  FAILED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum RejectionReason {
  MISSING_EXPERIENCE
  MISSING_SKILLS
  SALARY_MISMATCH
  COMMUNICATION
  TECHNICAL_PERFORMANCE
  ROLE_CLOSED
  CULTURE_FIT
  POSITION_CANCELLED
  OTHER
}

// ---------- Additional Models ----------
model ApplicationEvent {
  id            String      @id @default(uuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  type          EventType
  timestamp     DateTime    @default(now())
  actorId       String
  notes         String?
}

model Offer {
  id            String      @id @default(uuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String      @unique
  title         String
  salary        Int
  bonus         Int?
  benefits      String?
  joiningDate   DateTime
  workModel     String
  noticePeriod  String?
  expiryDate    DateTime
  letterUrl     String?
  status        OfferStatus @default(PENDING)
}

model Rejection {
  id             String          @id @default(uuid())
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId  String          @unique
  reason         RejectionReason
  suggestions    String[]
  closingMessage String
}
