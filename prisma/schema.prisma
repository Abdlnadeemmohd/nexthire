generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  name             String
  passwordHash     String?
  role             UserRole       @default(JOB_SEEKER)
  avatar           String?
  headline         String?
  bio              String?
  location         String?
  phone            String?
  isDiscoverable   Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  companyId        String?
  firebaseUid      String?        @unique
  applications     Application[]  @relation("SeekerApplications")
  jobs             Job[]          @relation("RecruiterJobs")
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  profile                 Profile?
  savedJobs        SavedJob[]
  sessions         Session[]
  trials           RecruiterTrial[]
  subscriptions    Subscription[]
  dailyUsages      DailyUsage[]
  unlockedCandidates CandidateUnlock[] @relation("RecruiterUnlocks")
  unlockedBy       CandidateUnlock[] @relation("CandidateUnlocked")
  sentContactRequests ContactRequest[] @relation("SentContactRequests")
  receivedContactRequests ContactRequest[] @relation("ReceivedContactRequests")
  resumeAccessLogs ResumeAccessLog[] @relation("RecruiterResumeLogs")
  resumeTargetLogs ResumeAccessLog[] @relation("CandidateResumeLogs")
  createdAssessments Assessment[] @relation("RecruiterAssessments")
  assessmentInvitations AssessmentInvitation[] @relation("CandidateInvitations")
  assessmentSubmissions AssessmentSubmission[] @relation("CandidateSubmissions")
  createdOutreachCampaigns OutreachCampaign[] @relation("RecruiterOutreachCampaigns")
  outreachRecipients       OutreachRecipient[] @relation("CandidateOutreachRecipients")
  candidateCommunicationPreference CandidateCommunicationPreference?
  candidateInterviewPlans  InterviewPlan[] @relation("CandidateInterviewPlans")
  candidateScorecards      InterviewScorecard[] @relation("CandidateScorecards")
  interviewerScorecards    InterviewScorecard[] @relation("InterviewerScorecards")
  candidateDecisions       InterviewDecision[] @relation("CandidateDecisions")
  decidedInterviews        InterviewDecision[] @relation("DecidedInterviews")
  teamMemberships          TeamMembership[] @relation("UserTeamMemberships")
  assignedCandidateRecords CandidateAssignment[] @relation("AssignedCandidate")
  recruiterCandidateAssignments CandidateAssignment[] @relation("RecruiterCandidateAssignments")
  createdCandidateAssignments   CandidateAssignment[] @relation("CreatedCandidateAssignments")
  handoffsSent             RecruiterHandoff[] @relation("HandoffsSent")
  handoffsReceived         RecruiterHandoff[] @relation("HandoffsReceived")
  handoffCandidates        RecruiterHandoff[] @relation("HandoffCandidates")
  authorCollaborationNotes CollaborationNote[] @relation("AuthorCollaborationNotes")
  candidateCollaborationNotes CollaborationNote[] @relation("CandidateCollaborationNotes")
  assignedHiringTasks      HiringTask[] @relation("AssignedHiringTasks")
  createdHiringTasks       HiringTask[] @relation("CreatedHiringTasks")
  createdHiringPlans       HiringPlan[] @relation("CreatedHiringPlans")
  assignedHiringPlanRoles  HiringPlanRole[] @relation("AssignedHiringPlanRoles")
  generatedExecutiveReports ExecutiveReport[] @relation("GeneratedExecutiveReports")
  company          Company?       @relation(fields: [companyId], references: [id])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isRevoked  Boolean  @default(false)
  userAgent  String?
  ipHash     String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Company {
  id            String   @id @default(uuid())
  name          String
  logo          String?
  coverImage    String?
  industry      String
  location      String
  description   String
  website       String?
  companyType   String?
  companySize   String?
  foundedYear   Int?
  tagline       String?
  mission       String?
  vision        String?
  values        String?  @default("[]")
  culture       String?
  techStack     String?  @default("[]")
  benefits      String?  @default("[]")
  locations     String?  @default("[]")
  links         String?  @default("[]")
  media         String?  @default("[]")
  remotePolicy  String?
  isVerified    Boolean  @default(true)
  slaDays       Int      @default(7)
  autoCloseDays Int      @default(20)
  createdAt     DateTime @default(now())
  jobs          Job[]
  users         User[]
  trials        RecruiterTrial[]
  subscriptions Subscription[]
  assessments   Assessment[]
  assessmentInvitations AssessmentInvitation[]
  outreachCampaigns OutreachCampaign[]
  interviewPlans    InterviewPlan[]
  interviewScorecards InterviewScorecard[]
  interviewDecisions  InterviewDecision[]
  recruiterTeams           RecruiterTeam[]
  teamMemberships          TeamMembership[]
  candidateAssignments    CandidateAssignment[]
  recruiterHandoffs        RecruiterHandoff[]
  collaborationNotes       CollaborationNote[]
  hiringTasks              HiringTask[]
  hiringPlans              HiringPlan[]
  executiveReports         ExecutiveReport[]
}

model Job {
  id               String         @id @default(uuid())
  title            String
  description      String
  responsibilities String
  requirements     String
  benefits         String
  location         String
  country          String
  salaryMin        Int
  salaryMax        Int
  employmentType   EmploymentType @default(FULL_TIME)
  experienceLevel  String
  category         String
  isRemote         Boolean        @default(false)
  skills           String
  status           JobStatus      @default(ACTIVE)
  isTrialJob       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  companyId        String
  recruiterId      String
  applications     Application[]
  assessments      Assessment[]
  outreachCampaigns OutreachCampaign[]
  interviewPlans    InterviewPlan[]
  interviewDecisions InterviewDecision[]
  company          Company        @relation(fields: [companyId], references: [id])
  recruiter        User           @relation("RecruiterJobs", fields: [recruiterId], references: [id])
  savedBy          SavedJob[]

  @@index([title])
  @@index([location])
  @@index([category])
  @@index([isRemote])
  @@index([status])
}

model Application {
  id          String             @id @default(uuid())
  status      ApplicationStatus  @default(SUBMITTED)
  matchScore  Int                @default(85)
  resumeUrl   String?
  coverLetter String?
  notes       String?
  appliedAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  slaDeadline DateTime?
  jobId       String
  applicantId String
  applicant   User               @relation("SeekerApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events      ApplicationEvent[]
  interviews  Interview[]
  offer       Offer?
  rejection   Rejection?
  assessmentInvitations AssessmentInvitation[]
  outreachRecipients    OutreachRecipient[]
  interviewScorecards   InterviewScorecard[]
  interviewDecisions    InterviewDecision[]
}

model SavedJob {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Interview {
  id            String          @id @default(uuid())
  round         Int
  scheduledAt   DateTime
  timezone      String
  type          String
  platform      String
  meetingLink   String?
  agenda        String?
  panelMembers  String[]
  documents     String[]
  notes         String?
  status        InterviewStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan          InterviewPlan?
  scorecards    InterviewScorecard[]
  summary       InterviewSummary?
}

model Message {
  id         String   @id @default(uuid())
  content    String
  attachment String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(uuid())
  title       String
  body        String
  type        String
  category    String    @default("SYSTEM") // APPLICATIONS, MESSAGES, INTERVIEWS, JOBS, TALENT_INTELLIGENCE, BILLING, SECURITY, SYSTEM
  priority    String    @default("NORMAL") // CRITICAL, IMPORTANT, NORMAL, INFORMATIONAL
  read        Boolean   @default(false)
  ctaText     String?
  ctaUrl      String?
  metadata    String?   // JSON metadata
  dedupKey    String?
  emailStatus String    @default("NOT_QUEUED") // NOT_QUEUED, QUEUED, SENDING, SENT, DELIVERED, FAILED, RETRYING, SKIPPED_PREFERENCE
  emailError  String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([read])
  @@index([dedupKey])
  @@index([createdAt])
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  preferences     String   @default("{}") // JSON map: { "APPLICATIONS": true, "MESSAGES": true, ... }
  digestFrequency String   @default("WEEKLY") // INSTANT, DAILY, WEEKLY, NONE
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id               String   @id @default(uuid())
  skills           String   @default("")
  experience       String   @default("[]")
  education        String   @default("[]")
  portfolio        String   @default("{}")
  certifications   String?  @default("[]")
  projects         String?  @default("[]")
  links            String?  @default("[]")
  achievements     String?  @default("[]")
  publications     String?  @default("[]")
  languages        String?  @default("[]")
  volunteer        String?  @default("[]")
  courses          String?  @default("[]")
  preferences      String?  @default("{}")
  visibility       String?  @default("{}")
  recruiterProfile String?  @default("{}")
  completeness     Int?     @default(0)
  resumeUrl        String?
  resumeScore      Int      @default(92)
  updatedAt        DateTime @updatedAt
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApplicationEvent {
  id            String      @id @default(uuid())
  applicationId String
  type          EventType
  timestamp     DateTime    @default(now())
  actorId       String
  notes         String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Offer {
  id            String      @id @default(uuid())
  applicationId String      @unique
  title         String
  salary        Int
  bonus         Int?
  benefits      String?
  joiningDate   DateTime
  workModel     String
  noticePeriod  String?
  expiryDate    DateTime
  letterUrl     String?
  status        OfferStatus @default(PENDING)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Rejection {
  id             String          @id @default(uuid())
  applicationId  String          @unique
  reason         RejectionReason
  suggestions    String[]
  closingMessage String
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String
  action       String
  resourceType String
  resourceId   String?
  metadata     String?
  timestamp    DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resourceType])
}

enum UserRole {
  JOB_SEEKER
  RECRUITER
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
  HYBRID
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  INTERVIEW_ROUND_1
  INTERVIEW_ROUND_2
  INTERVIEW_ROUND_3
  FINAL_DECISION
  OFFER_EXTENDED
  REJECTED
  APPLICATION_CLOSED
}

enum EventType {
  STATUS_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  OFFER_CREATED
  REJECTION_SUBMITTED
  NOTE_ADDED
  SLA_REMINDER_SENT
  AUTO_CLOSED
}

enum InterviewStatus {
  PENDING
  PASSED
  FAILED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum RejectionReason {
  MISSING_EXPERIENCE
  MISSING_SKILLS
  SALARY_MISMATCH
  COMMUNICATION
  TECHNICAL_PERFORMANCE
  ROLE_CLOSED
  CULTURE_FIT
  POSITION_CANCELLED
  OTHER
}

model RecruiterTrial {
  id                    String      @id @default(uuid())
  recruiterId           String      @unique
  companyId             String
  candidateSearchLimit  Int         @default(5)
  candidateSearchesUsed Int         @default(0)
  jobPostingLimit       Int         @default(1)
  jobPostingsUsed       Int         @default(0)
  startedAt             DateTime    @default(now())
  completedAt           DateTime?
  status                TrialStatus @default(ACTIVE)
  recruiter             User        @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  company               Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@index([companyId])
  @@index([status])
}

model SubscriptionPlan {
  id                   String              @id
  name                 String
  tier                 PlanTier
  price                Int                 @default(0)
  currency             String              @default("INR")
  durationDays         Int                 @default(30)
  candidateSearchLimit Int                 @default(5)
  candidateUnlockLimit Int                 @default(0)
  resumeUnlockLimit    Int                 @default(0)
  messageLimit         Int                 @default(10)
  messagingLevel       MessagingLevel      @default(LIMITED_MESSAGE)
  contactSharingLevel  ContactSharingLevel @default(MASKED)
  jobPostingLimit      Int                 @default(1)
  advancedSearch       Boolean             @default(false)
  savedSearches        Boolean             @default(false)
  aiMatching           Boolean             @default(false)
  analytics            Boolean             @default(false)
  prioritySupport      Boolean             @default(false)
  isActive             Boolean             @default(true)
  displayOrder         Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  subscriptions        Subscription[]
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String
  companyId  String?
  planId     String
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  endDate    DateTime
  autoRenew  Boolean            @default(false)
  paymentId  String?
  amountPaid Int                @default(0)
  currency   String             @default("INR")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company?           @relation(fields: [companyId], references: [id])
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model DailyUsage {
  id                String   @id @default(uuid())
  userId            String
  date              String   // YYYY-MM-DD
  candidateSearches Int      @default(0)
  candidateUnlocks  Int      @default(0)
  resumeUnlocks     Int      @default(0)
  messages          Int      @default(0)
  contactRequests   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model CandidateUnlock {
  id          String   @id @default(uuid())
  recruiterId String
  candidateId String
  unlockedAt  DateTime @default(now())
  recruiter   User     @relation("RecruiterUnlocks", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate   User     @relation("CandidateUnlocked", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, candidateId])
  @@index([recruiterId])
  @@index([candidateId])
}

model ContactRequest {
  id          String               @id @default(uuid())
  recruiterId String
  candidateId String
  status      ContactRequestStatus @default(PENDING)
  message     String?
  createdAt   DateTime             @default(now())
  respondedAt DateTime?
  recruiter   User                 @relation("SentContactRequests", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate   User                 @relation("ReceivedContactRequests", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@index([candidateId])
  @@index([status])
}

model ResumeAccessLog {
  id          String   @id @default(uuid())
  recruiterId String
  candidateId String
  action      String   // "PREVIEW" | "DOWNLOAD" | "UNLOCK"
  timestamp   DateTime @default(now())
  ipAddress   String?
  recruiter   User     @relation("RecruiterResumeLogs", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate   User     @relation("CandidateResumeLogs", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@index([candidateId])
}

enum TrialStatus {
  AVAILABLE
  ACTIVE
  COMPLETED
  EXPIRED
  SUSPENDED
}

enum PlanTier {
  TRIAL
  SILVER
  GOLD
  DIAMOND
  PLATINUM
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
  SUSPENDED
}

enum MessagingLevel {
  LIMITED_MESSAGE
  BASIC_MESSAGE
  ENHANCED_MESSAGE
  CONTACT_REQUEST
  ADVANCED_MESSAGE
}

enum ContactSharingLevel {
  MASKED
  CONTROLLED_REQUEST
  DIRECT_PERMISSION
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED_EMAIL
  ACCEPTED_PHONE
  ACCEPTED_ALL
  DECLINED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  KNOWLEDGE
  SCENARIO
  PRACTICAL
  DEBUGGING
}

enum InvitationStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum SubmissionStatus {
  UNDER_REVIEW
  EVALUATED
  VERIFIED
}

model Assessment {
  id              String             @id @default(uuid())
  title           String
  description     String
  category        String             @default("General Technical")
  durationMinutes Int                @default(45)
  passingScore    Int                @default(70)
  status          AssessmentStatus   @default(DRAFT)
  companyId       String
  jobId           String?
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job             Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy       User               @relation("RecruiterAssessments", fields: [createdById], references: [id], onDelete: Cascade)
  questions       AssessmentQuestion[]
  invitations     AssessmentInvitation[]
  submissions     AssessmentSubmission[]

  @@index([companyId])
  @@index([jobId])
  @@index([status])
}

model AssessmentQuestion {
  id           String       @id @default(uuid())
  assessmentId String
  category     String
  type         QuestionType @default(KNOWLEDGE)
  question     String
  codeSnippet  String?
  sampleAnswer String?
  rubric       String       @default("[]") // JSON array of criteria [{ name, maxScore, description }]
  maxScore     Int          @default(20)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers      AssessmentAnswer[]

  @@index([assessmentId])
}

model AssessmentInvitation {
  id            String             @id @default(uuid())
  assessmentId  String
  applicationId String?
  candidateId   String
  companyId     String
  status        InvitationStatus   @default(PENDING)
  deadline      DateTime
  invitedAt     DateTime           @default(now())
  startedAt     DateTime?
  submittedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  application   Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  candidate     User               @relation("CandidateInvitations", fields: [candidateId], references: [id], onDelete: Cascade)
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submission    AssessmentSubmission?

  @@index([assessmentId])
  @@index([candidateId])
  @@index([companyId])
  @@index([applicationId])
  @@index([status])
}

model AssessmentSubmission {
  id                      String           @id @default(uuid())
  invitationId            String           @unique
  assessmentId            String
  candidateId             String
  overallScore            Int              @default(0)
  categoryScores          String           @default("{}") // JSON: { [category]: score }
  evidenceSummary         String           @default("{}") // JSON: { demonstrated: [], partial: [], missing: [], inconsistencies: [] }
  skillVerificationMatrix  String           @default("[]") // JSON: [{ skill, resumeClaim, assessmentEvidence, confidence }]
  recommendedQuestions    String           @default("[]") // JSON: [{ skill, question, rationale }]
  status                  SubmissionStatus @default(UNDER_REVIEW)
  submittedAt             DateTime         @default(now())
  evaluatedAt             DateTime?
  invitation              AssessmentInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  assessment              Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate               User             @relation("CandidateSubmissions", fields: [candidateId], references: [id], onDelete: Cascade)
  answers                 AssessmentAnswer[]

  @@index([assessmentId])
  @@index([candidateId])
  @@index([status])
}

model AssessmentAnswer {
  id             String               @id @default(uuid())
  submissionId   String
  questionId     String
  answerText     String
  score          Int                  @default(0)
  feedback       String?
  evidencePoints String               @default("[]") // JSON string array
  gapPoints      String               @default("[]") // JSON string array
  createdAt      DateTime             @default(now())
  submission     AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question       AssessmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionId])
}

enum OutreachCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum OutreachMessageType {
  INITIAL_OUTREACH
  FOLLOW_UP
  VALUE_FOLLOW_UP
  FINAL_FOLLOW_UP
  INTERVIEW_INVITATION
  ASSESSMENT_INVITATION
}

enum PersonalizationLevel {
  STANDARD
  PERSONALIZED
  EVIDENCE_BASED
}

enum OutreachRecipientStatus {
  DRAFT
  APPROVED
  QUEUED
  SENT
  DELIVERED
  FAILED
  REPLIED
  BOUNCED
  OPTED_OUT
  PAUSED
  CANCELLED
}

enum ResponseClassification {
  POSITIVE_INTEREST
  NEGATIVE
  REQUEST_MORE_INFORMATION
  REQUEST_SALARY
  REQUEST_JOB_DETAILS
  NOT_AVAILABLE
  INTERESTED_LATER
  NEEDS_CLARIFICATION
  UNKNOWN
}

enum EngagementIntent {
  HIGH_INTENT
  MODERATE_INTENT
  LOW_INTENT
  NO_RESPONSE
  OPTED_OUT
}

model OutreachCampaign {
  id            String                 @id @default(uuid())
  name          String
  description   String?
  status        OutreachCampaignStatus @default(DRAFT)
  companyId     String
  recruiterId   String
  jobId         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter     User                   @relation("RecruiterOutreachCampaigns", fields: [recruiterId], references: [id], onDelete: Cascade)
  job           Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  sequenceSteps OutreachSequenceStep[]
  recipients    OutreachRecipient[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([jobId])
  @@index([status])
}

model OutreachSequenceStep {
  id                   String               @id @default(uuid())
  campaignId           String
  stepOrder            Int                  @default(1) // 1, 2, 3, 4
  delayDays            Int                  @default(0) // 0, 3, 7, 14
  messageType          OutreachMessageType  @default(INITIAL_OUTREACH)
  personalizationLevel PersonalizationLevel @default(PERSONALIZED)
  subjectTemplate      String
  bodyTemplate         String
  isEnabled            Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  campaign             OutreachCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages             OutreachMessage[]

  @@index([campaignId])
  @@index([stepOrder])
}

model OutreachRecipient {
  id                     String                  @id @default(uuid())
  campaignId             String
  candidateId            String
  applicationId          String?
  status                 OutreachRecipientStatus @default(DRAFT)
  currentStep            Int                     @default(1)
  nextActionAt           DateTime?
  lastContactedAt        DateTime?
  repliedAt              DateTime?
  responseClassification ResponseClassification?
  responseSentiment      String?
  recommendedNextAction  String?
  engagementIntent       EngagementIntent?
  optedOutAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  campaign               OutreachCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  candidate              User                    @relation("CandidateOutreachRecipients", fields: [candidateId], references: [id], onDelete: Cascade)
  application            Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  messages               OutreachMessage[]

  @@unique([campaignId, candidateId])
  @@index([campaignId])
  @@index([candidateId])
  @@index([status])
  @@index([nextActionAt])
}

model OutreachMessage {
  id                String                  @id @default(uuid())
  recipientId       String
  stepId            String?
  subject           String
  body              String
  status            OutreachRecipientStatus @default(DRAFT)
  emailId           String?
  inAppMessageId    String?
  recruiterApproved Boolean                 @default(false)
  approvedAt        DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  recipient         OutreachRecipient       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  step              OutreachSequenceStep?   @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([stepId])
  @@index([status])
  @@index([emailId])
}

model CandidateCommunicationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  optedOutOutreach   Boolean  @default(false)
  allowEmailOutreach Boolean  @default(true)
  allowInAppOutreach Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CompetencyVerificationStatus {
  VERIFIED
  PARTIALLY_VERIFIED
  UNVERIFIED
}

enum InterviewerRecommendation {
  STRONG_YES
  YES
  MAYBE
  NO
  STRONG_NO
}

enum InterviewDecisionType {
  ADVANCE
  HOLD
  REJECT
  OFFER
  WITHDRAW
}

enum EvidenceQualityLevel {
  HIGH
  MEDIUM
  LOW
}

model InterviewPlan {
  id              String   @id @default(uuid())
  interviewId     String   @unique
  companyId       String
  jobId           String?
  candidateId     String
  interviewType   String   @default("TECHNICAL")
  durationMinutes Int      @default(45)
  objectives      String   @default("[]") // JSON string array
  competencies    String   @default("[]") // JSON string array of evaluated competencies
  questions       String   @default("[]") // JSON array: [{ category, question, followUp, evidenceToLookFor, redFlags, verificationStatus }]
  unverifiedGaps  String   @default("[]") // JSON string array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job             Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  candidate       User      @relation("CandidateInterviewPlans", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([companyId])
  @@index([candidateId])
  @@index([jobId])
}

model InterviewScorecard {
  id                    String                    @id @default(uuid())
  interviewId           String
  companyId             String
  applicationId         String
  candidateId           String
  interviewerId         String
  overallRecommendation InterviewerRecommendation @default(YES)
  strongestEvidence     String?
  biggestConcern        String?
  rawNotes              String?
  structuredNotes       String?                   @default("{}") // JSON: { strengths: [], concerns: [], observedEvidence: [], unverifiedAreas: [], followUpQuestions: [] }
  isComplete            Boolean                   @default(false)
  submittedAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  interview             Interview                 @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application           Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate             User                      @relation("CandidateScorecards", fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer           User                      @relation("InterviewerScorecards", fields: [interviewerId], references: [id], onDelete: Cascade)
  scores                InterviewScore[]

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
  @@index([companyId])
  @@index([candidateId])
  @@index([interviewerId])
  @@index([applicationId])
}

model InterviewScore {
  id                 String             @id @default(uuid())
  scorecardId        String
  competency         String             // e.g. "Technical Skills", "Problem Solving", "Communication", "Role Knowledge", "Ownership", "Leadership", "Relevant Experience"
  score              Int                @default(3) // 1 to 5
  observedEvidence   String?            // Concrete demonstrated facts
  interviewerOpinion String?            // Subjective reviewer perception
  aiInference        String?            // Synthesized analysis
  confidence         String             @default("MEDIUM") // HIGH, MEDIUM, LOW
  recommendation     String?
  createdAt          DateTime           @default(now())

  scorecard          InterviewScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@index([scorecardId])
}

model InterviewSummary {
  id                     String               @id @default(uuid())
  interviewId            String               @unique
  companyId              String
  strengths              String               @default("[]") // JSON array of string statements with citations
  concerns               String               @default("[]") // JSON array of string statements
  verifiedCompetencies   String               @default("[]") // JSON array of strings
  unverifiedCompetencies String               @default("[]") // JSON array of strings
  recommendedFollowUp    String               @default("[]") // JSON array of strings
  conflictingEvidence    String               @default("[]") // JSON array: [{ sourceA, sourceB, conflictDescription, clarificationQuestion }]
  evidenceQuality        EvidenceQualityLevel @default(MEDIUM)
  aiSynthesis            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  interview              Interview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([companyId])
}

model InterviewDecision {
  id                 String                @id @default(uuid())
  applicationId      String
  candidateId        String
  jobId              String
  companyId          String
  decisionMakerId    String
  decision           InterviewDecisionType @default(ADVANCE)
  decisionReason     String
  evidenceSummary    String                // Grounded summary of facts supporting decision
  conflictingNotes   String?
  confirmedAt        DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  application        Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate          User                  @relation("CandidateDecisions", fields: [candidateId], references: [id], onDelete: Cascade)
  job                Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  decisionMaker      User                  @relation("DecidedInterviews", fields: [decisionMakerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([candidateId])
  @@index([jobId])
  @@index([companyId])
  @@index([decisionMakerId])
}

// ============================================================================
// PHASE 13: RECRUITER GROWTH, TEAM COLLABORATION & HIRING OPERATIONS
// ============================================================================

enum TeamRole {
  TEAM_MEMBER
  TEAM_LEAD
  HIRING_MANAGER
}

model RecruiterTeam {
  id          String   @id @default(uuid())
  name        String
  description String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]
  candidateAssignments CandidateAssignment[]

  @@index([companyId])
}

model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  companyId String
  role      TeamRole @default(TEAM_MEMBER)
  createdAt DateTime @default(now())

  team      RecruiterTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User          @relation("UserTeamMemberships", fields: [userId], references: [id], onDelete: Cascade)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([companyId])
}

enum AssignmentStatus {
  ACTIVE
  TRANSFERRED
  UNASSIGNED
}

model CandidateAssignment {
  id             String           @id @default(uuid())
  companyId      String
  candidateId    String
  applicationId  String?
  jobId          String?
  recruiterId    String
  teamId         String?
  assignedById   String
  reason         String?
  status         AssignmentStatus @default(ACTIVE)
  assignedAt     DateTime         @default(now())
  unassignedAt   DateTime?

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate      User             @relation("AssignedCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  recruiter      User             @relation("RecruiterCandidateAssignments", fields: [recruiterId], references: [id], onDelete: Cascade)
  assignedBy     User             @relation("CreatedCandidateAssignments", fields: [assignedById], references: [id], onDelete: Cascade)
  team           RecruiterTeam?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([candidateId])
  @@index([applicationId])
  @@index([jobId])
  @@index([recruiterId])
  @@index([status])
}

enum HandoffStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model RecruiterHandoff {
  id                    String        @id @default(uuid())
  companyId             String
  fromRecruiterId       String
  toRecruiterId         String
  candidateId           String
  applicationId         String?
  jobId                 String?
  reason                String
  currentStage          String
  completedWork         String        @default("[]") // JSON string array
  pendingWork           String        @default("[]") // JSON string array
  importantEvidence     String?
  nextRecommendedAction String?
  status                HandoffStatus @default(PENDING)
  dueAt                 DateTime?
  acceptedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromRecruiter         User          @relation("HandoffsSent", fields: [fromRecruiterId], references: [id], onDelete: Cascade)
  toRecruiter           User          @relation("HandoffsReceived", fields: [toRecruiterId], references: [id], onDelete: Cascade)
  candidate             User          @relation("HandoffCandidates", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fromRecruiterId])
  @@index([toRecruiterId])
  @@index([candidateId])
  @@index([status])
}

enum CollaborationNoteType {
  GENERAL
  INTERVIEW
  ASSESSMENT
  OUTREACH
  HANDOFF
  DECISION_SUPPORT
}

model CollaborationNote {
  id            String                @id @default(uuid())
  companyId     String
  authorId      String
  candidateId   String
  applicationId String?
  jobId         String?
  noteType      CollaborationNoteType @default(GENERAL)
  content       String
  mentions      String                @default("[]") // JSON array of { userId, name }
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author        User                  @relation("AuthorCollaborationNotes", fields: [authorId], references: [id], onDelete: Cascade)
  candidate     User                  @relation("CandidateCollaborationNotes", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([candidateId])
  @@index([authorId])
  @@index([applicationId])
  @@index([jobId])
}

enum HiringTaskPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum HiringTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

model HiringTask {
  id            String             @id @default(uuid())
  companyId     String
  title         String
  description   String?
  priority      HiringTaskPriority @default(NORMAL)
  status        HiringTaskStatus   @default(TODO)
  assigneeId    String
  creatorId     String
  candidateId   String?
  applicationId String?
  jobId         String?
  dueAt         DateTime?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee      User               @relation("AssignedHiringTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator       User               @relation("CreatedHiringTasks", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([dueAt])
}

enum HiringPlanStatus {
  TARGET
  IN_PROGRESS
  AT_RISK
  BEHIND
  COMPLETED
}

enum ExecutiveReportPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum ExecutiveRiskLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  NONE
}

model HiringPlan {
  id           String           @id @default(uuid())
  companyId    String
  title        String
  department   String
  targetHires  Int
  filledHires  Int              @default(0)
  startDate    DateTime
  targetDate   DateTime
  budget       Float?
  priority     String           @default("MEDIUM")
  status       HiringPlanStatus @default(TARGET)
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("CreatedHiringPlans", fields: [createdById], references: [id], onDelete: Cascade)
  roles        HiringPlanRole[]

  @@index([companyId])
  @@index([createdById])
  @@index([status])
}

model HiringPlanRole {
  id                  String           @id @default(uuid())
  hiringPlanId        String
  roleTitle           String
  jobId               String?
  targetHires         Int              @default(1)
  filledHires         Int              @default(0)
  assignedRecruiterId String?
  status              HiringPlanStatus @default(TARGET)
  targetDate          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  hiringPlan          HiringPlan       @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  assignedRecruiter   User?            @relation("AssignedHiringPlanRoles", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)

  @@index([hiringPlanId])
  @@index([assignedRecruiterId])
}

model ExecutiveReport {
  id                  String                @id @default(uuid())
  companyId           String
  title               String
  period              ExecutiveReportPeriod @default(MONTHLY)
  startDate           DateTime
  endDate             DateTime
  summaryJson         String
  metricsJson         String
  risksJson           String
  recommendationsJson String
  generatedById       String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedBy         User                  @relation("GeneratedExecutiveReports", fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([generatedById])
}
