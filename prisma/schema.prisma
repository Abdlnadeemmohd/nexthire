generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  name             String
  passwordHash     String?
  role             UserRole       @default(JOB_SEEKER)
  avatar           String?
  headline         String?
  bio              String?
  location         String?
  phone            String?
  isDiscoverable   Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  companyId        String?
  firebaseUid      String?        @unique
  applications     Application[]  @relation("SeekerApplications")
  jobs             Job[]          @relation("RecruiterJobs")
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  profile                 Profile?
  savedJobs        SavedJob[]
  sessions         Session[]
  trials           RecruiterTrial[]
  subscriptions    Subscription[]
  dailyUsages      DailyUsage[]
  unlockedCandidates CandidateUnlock[] @relation("RecruiterUnlocks")
  unlockedBy       CandidateUnlock[] @relation("CandidateUnlocked")
  sentContactRequests ContactRequest[] @relation("SentContactRequests")
  receivedContactRequests ContactRequest[] @relation("ReceivedContactRequests")
  resumeAccessLogs ResumeAccessLog[] @relation("RecruiterResumeLogs")
  resumeTargetLogs ResumeAccessLog[] @relation("CandidateResumeLogs")
  company          Company?       @relation(fields: [companyId], references: [id])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isRevoked  Boolean  @default(false)
  userAgent  String?
  ipHash     String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Company {
  id            String   @id @default(uuid())
  name          String
  logo          String?
  coverImage    String?
  industry      String
  location      String
  description   String
  website       String?
  companyType   String?
  companySize   String?
  foundedYear   Int?
  tagline       String?
  mission       String?
  vision        String?
  values        String?  @default("[]")
  culture       String?
  techStack     String?  @default("[]")
  benefits      String?  @default("[]")
  locations     String?  @default("[]")
  links         String?  @default("[]")
  media         String?  @default("[]")
  remotePolicy  String?
  isVerified    Boolean  @default(true)
  slaDays       Int      @default(7)
  autoCloseDays Int      @default(20)
  createdAt     DateTime @default(now())
  jobs          Job[]
  users         User[]
  trials        RecruiterTrial[]
  subscriptions Subscription[]
}

model Job {
  id               String         @id @default(uuid())
  title            String
  description      String
  responsibilities String
  requirements     String
  benefits         String
  location         String
  country          String
  salaryMin        Int
  salaryMax        Int
  employmentType   EmploymentType @default(FULL_TIME)
  experienceLevel  String
  category         String
  isRemote         Boolean        @default(false)
  skills           String
  status           JobStatus      @default(ACTIVE)
  isTrialJob       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  companyId        String
  recruiterId      String
  applications     Application[]
  company          Company        @relation(fields: [companyId], references: [id])
  recruiter        User           @relation("RecruiterJobs", fields: [recruiterId], references: [id])
  savedBy          SavedJob[]

  @@index([title])
  @@index([location])
  @@index([category])
  @@index([isRemote])
  @@index([status])
}

model Application {
  id          String             @id @default(uuid())
  status      ApplicationStatus  @default(SUBMITTED)
  matchScore  Int                @default(85)
  resumeUrl   String?
  coverLetter String?
  notes       String?
  appliedAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  slaDeadline DateTime?
  jobId       String
  applicantId String
  applicant   User               @relation("SeekerApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events      ApplicationEvent[]
  interviews  Interview[]
  offer       Offer?
  rejection   Rejection?
}

model SavedJob {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Interview {
  id            String          @id @default(uuid())
  round         Int
  scheduledAt   DateTime
  timezone      String
  type          String
  platform      String
  meetingLink   String?
  agenda        String?
  panelMembers  String[]
  documents     String[]
  notes         String?
  status        InterviewStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(uuid())
  content    String
  attachment String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(uuid())
  title       String
  body        String
  type        String
  category    String    @default("SYSTEM") // APPLICATIONS, MESSAGES, INTERVIEWS, JOBS, TALENT_INTELLIGENCE, BILLING, SECURITY, SYSTEM
  priority    String    @default("NORMAL") // CRITICAL, IMPORTANT, NORMAL, INFORMATIONAL
  read        Boolean   @default(false)
  ctaText     String?
  ctaUrl      String?
  metadata    String?   // JSON metadata
  dedupKey    String?
  emailStatus String    @default("NOT_QUEUED") // NOT_QUEUED, QUEUED, SENDING, SENT, DELIVERED, FAILED, RETRYING, SKIPPED_PREFERENCE
  emailError  String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([read])
  @@index([dedupKey])
  @@index([createdAt])
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  preferences     String   @default("{}") // JSON map: { "APPLICATIONS": true, "MESSAGES": true, ... }
  digestFrequency String   @default("WEEKLY") // INSTANT, DAILY, WEEKLY, NONE
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id               String   @id @default(uuid())
  skills           String   @default("")
  experience       String   @default("[]")
  education        String   @default("[]")
  portfolio        String   @default("{}")
  certifications   String?  @default("[]")
  projects         String?  @default("[]")
  links            String?  @default("[]")
  achievements     String?  @default("[]")
  publications     String?  @default("[]")
  languages        String?  @default("[]")
  volunteer        String?  @default("[]")
  courses          String?  @default("[]")
  preferences      String?  @default("{}")
  visibility       String?  @default("{}")
  recruiterProfile String?  @default("{}")
  completeness     Int?     @default(0)
  resumeUrl        String?
  resumeScore      Int      @default(92)
  updatedAt        DateTime @updatedAt
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApplicationEvent {
  id            String      @id @default(uuid())
  applicationId String
  type          EventType
  timestamp     DateTime    @default(now())
  actorId       String
  notes         String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Offer {
  id            String      @id @default(uuid())
  applicationId String      @unique
  title         String
  salary        Int
  bonus         Int?
  benefits      String?
  joiningDate   DateTime
  workModel     String
  noticePeriod  String?
  expiryDate    DateTime
  letterUrl     String?
  status        OfferStatus @default(PENDING)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Rejection {
  id             String          @id @default(uuid())
  applicationId  String          @unique
  reason         RejectionReason
  suggestions    String[]
  closingMessage String
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String
  action       String
  resourceType String
  resourceId   String?
  metadata     String?
  timestamp    DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resourceType])
}

enum UserRole {
  JOB_SEEKER
  RECRUITER
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
  HYBRID
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  INTERVIEW_ROUND_1
  INTERVIEW_ROUND_2
  INTERVIEW_ROUND_3
  FINAL_DECISION
  OFFER_EXTENDED
  REJECTED
  APPLICATION_CLOSED
}

enum EventType {
  STATUS_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  OFFER_CREATED
  REJECTION_SUBMITTED
  NOTE_ADDED
  SLA_REMINDER_SENT
  AUTO_CLOSED
}

enum InterviewStatus {
  PENDING
  PASSED
  FAILED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum RejectionReason {
  MISSING_EXPERIENCE
  MISSING_SKILLS
  SALARY_MISMATCH
  COMMUNICATION
  TECHNICAL_PERFORMANCE
  ROLE_CLOSED
  CULTURE_FIT
  POSITION_CANCELLED
  OTHER
}

model RecruiterTrial {
  id                    String      @id @default(uuid())
  recruiterId           String      @unique
  companyId             String
  candidateSearchLimit  Int         @default(5)
  candidateSearchesUsed Int         @default(0)
  jobPostingLimit       Int         @default(1)
  jobPostingsUsed       Int         @default(0)
  startedAt             DateTime    @default(now())
  completedAt           DateTime?
  status                TrialStatus @default(ACTIVE)
  recruiter             User        @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  company               Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@index([companyId])
  @@index([status])
}

model SubscriptionPlan {
  id                   String              @id
  name                 String
  tier                 PlanTier
  price                Int                 @default(0)
  currency             String              @default("INR")
  durationDays         Int                 @default(30)
  candidateSearchLimit Int                 @default(5)
  candidateUnlockLimit Int                 @default(0)
  resumeUnlockLimit    Int                 @default(0)
  messageLimit         Int                 @default(10)
  messagingLevel       MessagingLevel      @default(LIMITED_MESSAGE)
  contactSharingLevel  ContactSharingLevel @default(MASKED)
  jobPostingLimit      Int                 @default(1)
  advancedSearch       Boolean             @default(false)
  savedSearches        Boolean             @default(false)
  aiMatching           Boolean             @default(false)
  analytics            Boolean             @default(false)
  prioritySupport      Boolean             @default(false)
  isActive             Boolean             @default(true)
  displayOrder         Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  subscriptions        Subscription[]
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String
  companyId  String?
  planId     String
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  endDate    DateTime
  autoRenew  Boolean            @default(false)
  paymentId  String?
  amountPaid Int                @default(0)
  currency   String             @default("INR")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company?           @relation(fields: [companyId], references: [id])
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model DailyUsage {
  id                String   @id @default(uuid())
  userId            String
  date              String   // YYYY-MM-DD
  candidateSearches Int      @default(0)
  candidateUnlocks  Int      @default(0)
  resumeUnlocks     Int      @default(0)
  messages          Int      @default(0)
  contactRequests   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model CandidateUnlock {
  id          String   @id @default(uuid())
  recruiterId String
  candidateId String
  unlockedAt  DateTime @default(now())
  recruiter   User     @relation("RecruiterUnlocks", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate   User     @relation("CandidateUnlocked", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, candidateId])
  @@index([recruiterId])
  @@index([candidateId])
}

model ContactRequest {
  id          String               @id @default(uuid())
  recruiterId String
  candidateId String
  status      ContactRequestStatus @default(PENDING)
  message     String?
  createdAt   DateTime             @default(now())
  respondedAt DateTime?
  recruiter   User                 @relation("SentContactRequests", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate   User                 @relation("ReceivedContactRequests", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@index([candidateId])
  @@index([status])
}

model ResumeAccessLog {
  id          String   @id @default(uuid())
  recruiterId String
  candidateId String
  action      String   // "PREVIEW" | "DOWNLOAD" | "UNLOCK"
  timestamp   DateTime @default(now())
  ipAddress   String?
  recruiter   User     @relation("RecruiterResumeLogs", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate   User     @relation("CandidateResumeLogs", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@index([candidateId])
}

enum TrialStatus {
  AVAILABLE
  ACTIVE
  COMPLETED
  EXPIRED
  SUSPENDED
}

enum PlanTier {
  TRIAL
  SILVER
  GOLD
  DIAMOND
  PLATINUM
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
  SUSPENDED
}

enum MessagingLevel {
  LIMITED_MESSAGE
  BASIC_MESSAGE
  ENHANCED_MESSAGE
  CONTACT_REQUEST
  ADVANCED_MESSAGE
}

enum ContactSharingLevel {
  MASKED
  CONTROLLED_REQUEST
  DIRECT_PERMISSION
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED_EMAIL
  ACCEPTED_PHONE
  ACCEPTED_ALL
  DECLINED
}
